{
  "name": "bean-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "A reading-focused VitePress blog",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev": "vitepress dev src",
    "build": "vitepress build src",
    "build:local": "cross-env SITE_URL=https://username.github.io SITE_BASE=/ vitepress build src",
    "preview": "vitepress preview src",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "font:check": "pnpm --filter @bean-blog/lxgw-wenkai-lite-webfont check",
    "font:update": "pnpm --filter @bean-blog/lxgw-wenkai-lite-webfont update",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:styles": "node scripts/audit-styles.mjs",
    "generate:assets": "node scripts/generate-assets.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "pnpm generate:assets && pnpm font:check && pnpm audit:styles && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:build && pnpm test:e2e"
  },
  "dependencies": {
    "@bean-blog/lxgw-wenkai-lite-webfont": "workspace:*",
    "@giscus/vue": "^3.1.1",
    "@lucide/vue": "^1.38.0",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.4.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "zod": "^4.5.4"
  }
}
