{
  "name": "bean-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "A reading-focused VitePress blog",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev": "vitepress dev src",
    "build": "vitepress build src",
    "build:local": "cross-env SITE_URL=https://ccbeango.github.io SITE_BASE=/ vitepress build src",
    "preview": "vitepress preview src",
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "font:check": "pnpm --filter @bean-blog/lxgw-wenkai-lite-webfont check",
    "font:update": "pnpm --filter @bean-blog/lxgw-wenkai-lite-webfont update",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:styles": "node scripts/audit-styles.mjs",
    "check:staged": "lint-staged",
    "verify:build": "node scripts/verify-build.mjs",
    "check:build": "pnpm font:check && pnpm format:check && pnpm audit:styles && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:build",
    "check": "pnpm check:build && pnpm test:e2e"
  },
  "dependencies": {
    "@bean-blog/lxgw-wenkai-lite-webfont": "workspace:*",
    "@giscus/vue": "^3.1.1",
    "@lucide/vue": "^1.38.0",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "feed": "^6.0.0",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "lint-staged": "^16.4.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "zod": "^4.5.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check:staged"
  }
}
